erDiagram

    CUSTOMERS ||--o{ ORDERS : places
    CATEGORIES ||--o{ PRODUCTS : contains
    SUPPLIERS ||--o{ SUPPLIER_PRODUCTS : supplies
    PRODUCTS ||--o{ SUPPLIER_PRODUCTS : sourced_from
    PRODUCTS ||--|| INVENTORY : has
    ORDERS ||--|{ ORDER_ITEMS : contains
    PRODUCTS ||--o{ ORDER_ITEMS : included_in
    ORDERS ||--o{ PAYMENTS : receives
    ORDERS ||--o{ SHIPMENTS : has
    PRODUCTS ||--o{ STOCK_TRANSACTIONS : records

    CUSTOMERS {
        int customer_id PK
        string first_name
        string last_name
        string email
        string phone
        string address
        string city
        string state
        string postal_code
        datetime created_at
    }

    CATEGORIES {
        int category_id PK
        string category_name
        string description
    }

    PRODUCTS {
        int product_id PK
        int category_id FK
        string product_name
        string description
        decimal price
        string sku
        string status
        datetime created_at
    }

    SUPPLIERS {
        int supplier_id PK
        string supplier_name
        string email
        string phone
        string address
        string city
        datetime created_at
    }

    SUPPLIER_PRODUCTS {
        int supplier_product_id PK
        int supplier_id FK
        int product_id FK
        decimal supply_price
        int lead_time_days
    }

    INVENTORY {
        int inventory_id PK
        int product_id FK
        int quantity_available
        int reorder_level
        datetime last_updated
    }

    ORDERS {
        int order_id PK
        int customer_id FK
        datetime order_date
        string order_status
        decimal total_amount
        string shipping_address
    }

    ORDER_ITEMS {
        int order_item_id PK
        int order_id FK
        int product_id FK
        int quantity
        decimal unit_price
        decimal subtotal
    }

    PAYMENTS {
        int payment_id PK
        int order_id FK
        datetime payment_date
        string payment_method
        string payment_status
        decimal amount
    }

    SHIPMENTS {
        int shipment_id PK
        int order_id FK
        string tracking_number
        string courier_name
        datetime shipment_date
        datetime delivery_date
        string shipment_status
    }

    STOCK_TRANSACTIONS {
        int transaction_id PK
        int product_id FK
        string transaction_type
        int quantity
        datetime transaction_date
        string remarks
    }
